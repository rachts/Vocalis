# Gemini (required for LLM brain)
GEMINI_API_KEY=

# Deepgram (optional — falls back to Web Speech API if missing)
DEEPGRAM_API_KEY=

# ElevenLabs (optional — falls back to SpeechSynthesis if missing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# Supabase (optional — falls back to in-memory if missing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather (already exists — keep it)
WEATHER_API_KEY=

# Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
